# Supabase project settings (Project Settings > API in the Supabase dashboard).
# These are server-only secrets — do NOT prefix them with NEXT_PUBLIC_.
# The service role key bypasses Row Level Security, so it must never be
# shipped to the browser; it is only read from Server Components / Server
# Actions (see lib/supabase/server.ts, guarded by the `server-only` package).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
